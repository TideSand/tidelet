            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SandboxService"
        ]
      },
      "delete": {
        "summary": "DeleteSandbox removes a sandbox. A live sandbox is rejected unless\nforce is set.",
        "operationId": "SandboxService_DeleteSandbox",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1DeleteSandboxResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/v1alpha1/sandboxes/{sandbox}/logs": {
      "get": {
        "summary": "Logs streams the sandbox's recorded output, optionally following it\nuntil the sandbox exits.",
        "operationId": "SandboxService_Logs",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1alpha1LogsResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1alpha1LogsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "follow",
            "description": "Keep streaming until the sandbox exits.",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "tailLines",
            "description": "Only the last N lines. Zero means everything.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "since",
            "description": "Only entries at or after this time.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/v1alpha1/sandboxes/{sandbox}/stats": {
      "get": {
        "summary": "GetStats samples resource usage of a running sandbox.",
        "operationId": "SandboxService_GetStats",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1GetStatsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
