        },
        "status": {
          "$ref": "#/definitions/v1alpha1SandboxStatus"
        }
      }
    },
    "v1alpha1SandboxSpec": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "OCI image reference including the registry host."
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command replaces the image entrypoint; args replaces the image cmd."
        },
        "args": {
          "type": "array",
