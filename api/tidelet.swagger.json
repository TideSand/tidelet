            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "SandboxService"
        ]
      },
      "post": {
        "summary": "CreateSandbox submits a sandbox to the policy. The policy may run it\n(the sandbox is created in the runtime, not started, so a client can\nattach before the first byte of output), queue it for later, or\nreject it. Use StartSandbox to run it.",
        "operationId": "SandboxService_CreateSandbox",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1CreateSandboxResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1alpha1CreateSandboxRequest"
            }
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/v1alpha1/sandboxes/{sandbox}": {
      "get": {
        "operationId": "SandboxService_GetSandbox",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1GetSandboxResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
