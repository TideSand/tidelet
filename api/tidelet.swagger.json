            }
          }
        },
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/v1alpha1/sandboxes/{sandbox}:start": {
      "post": {
        "summary": "StartSandbox starts a created sandbox. On a queued sandbox it records\nthat a start is wanted, so the sandbox starts as soon as the policy\ndispatches it.",
        "operationId": "SandboxService_StartSandbox",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1StartSandboxResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "sandbox",
            "description": "Sandbox ID, name, or unique ID prefix. All \"sandbox\" fields below\naccept the same forms.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/v1alpha1/sandboxes/{sandbox}:stop": {
      "post": {
        "summary": "StopSandbox sends SIGTERM and, after the grace period, SIGKILL. It\nreturns once the process has exited.",
        "operationId": "SandboxService_StopSandbox",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1StopSandboxResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SandboxServiceStopSandboxBody"
            }
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/v1alpha1/version": {
