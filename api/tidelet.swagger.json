  "paths": {
    "/tidelet.v1alpha1.SandboxService/Attach": {
      "post": {
        "summary": "Attach connects to the main process's standard streams. The first\nmessage must be AttachStart. Output is streamed until the process\nexits or the client disconnects; the stream ends with Exit if the\nprocess exited.",
        "operationId": "SandboxService_Attach",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1alpha1AttachResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1alpha1AttachResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": " (streaming inputs)",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1alpha1AttachRequest"
            }
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
    "/tidelet.v1alpha1.SandboxService/Exec": {
      "post": {
        "summary": "Exec runs a command inside a running sandbox. The first message must\nbe ExecStart. Stdin, resize and close-stdin messages may follow. The\nserver streams stdout, stderr and finally an Exit message.",
        "operationId": "SandboxService_Exec",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1alpha1ExecResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1alpha1ExecResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": " (streaming inputs)",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1alpha1ExecRequest"
            }
          }
        ],
        "tags": [
          "SandboxService"
        ]
      }
    },
