    "v1alpha1LogStream": {
      "type": "string",
      "enum": [
        "LOG_STREAM_UNSPECIFIED",
        "LOG_STREAM_STDOUT",
        "LOG_STREAM_STDERR"
      ],
      "default": "LOG_STREAM_UNSPECIFIED"
    },
    "v1alpha1LogsResponse": {
      "type": "object",
      "properties": {
        "stream": {
          "$ref": "#/definitions/v1alpha1LogStream"
        },
        "data": {
          "type": "string",
          "format": "byte"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1alpha1Mount": {
      "type": "object",
      "properties": {
        "hostPath": {
          "type": "string"
        },
        "containerPath": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "description": "Mount is a bind mount from the host into the sandbox."
    },
    "v1alpha1NetworkMode": {
      "type": "string",
      "enum": [
        "NETWORK_MODE_UNSPECIFIED",
        "NETWORK_MODE_NONE",
        "NETWORK_MODE_HOST",
        "NETWORK_MODE_BRIDGE",
        "NETWORK_MODE_JOIN"
      ],
      "default": "NETWORK_MODE_UNSPECIFIED",
      "description": " - NETWORK_MODE_NONE: A private network namespace with only a loopback interface.\n - NETWORK_MODE_HOST: The host network namespace.\n - NETWORK_MODE_BRIDGE: A private network namespace attached to the node's CNI bridge, with\nan IP address and outbound NAT, like Docker's default network.\n - NETWORK_MODE_JOIN: Join the network namespace named by network_namespace, typically one\ncreated by another sandbox with NETWORK_MODE_BRIDGE. This is how the\ncontainers of a Pod share one network identity."
    },
    "v1alpha1NetworkStatus": {
      "type": "object",
      "properties": {
        "namespacePath": {
          "type": "string",
          "description": "Path of the sandbox's network namespace on the host, when it owns one."
        },
        "ipAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IP addresses assigned by CNI (e.g. 10.88.0.5)."
        }
      },
      "description": "NetworkStatus describes a sandbox's network attachment."
    },
    "v1alpha1NodeStatus": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "capacity": {
          "$ref": "#/definitions/v1alpha1ResourceList",
          "description": "Physical capacity."
        },
        "allocatable": {
          "$ref": "#/definitions/v1alpha1ResourceList",
          "description": "What the policy advertises as schedulable."
        },
        "allocated": {
          "$ref": "#/definitions/v1alpha1ResourceList",
          "description": "Sum of requests of sandboxes holding an allocation."
        },
        "sandboxCount": {
          "type": "integer",
          "format": "int32"
        },
        "queuedCount": {
          "type": "integer",
          "format": "int32",
          "description": "Sandboxes accepted but not yet created."
        }
      }
    },
    "v1alpha1Phase": {
      "type": "string",
      "enum": [
        "PHASE_UNSPECIFIED",
        "PHASE_PENDING",
        "PHASE_QUEUED",
        "PHASE_CREATED",
        "PHASE_RUNNING",
        "PHASE_FROZEN",
        "PHASE_EXITED",
        "PHASE_FAILED"
      ],
      "default": "PHASE_UNSPECIFIED",
      "description": " - PHASE_PENDING: Admission in progress or runtime creation in progress.\n - PHASE_QUEUED: Accepted by the policy but not yet created. Holds no allocation.\n - PHASE_CREATED: Created in the runtime but not started. Holds its allocation.\n - PHASE_FROZEN: Frozen by the policy via the cgroup freezer. Holds its allocation.\n - PHASE_FAILED: Could not be created or started, was lost by the runtime, or was\ngiven up on by the policy."
    },
    "v1alpha1ResourceList": {
      "type": "object",
      "properties": {
        "cpuMillicores": {
          "type": "string",
          "format": "int64"
        },
        "memoryBytes": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "ResourceList is a CPU and memory quantity. Zero means unset."
    },
    "v1alpha1Resources": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "#/definitions/v1alpha1ResourceList"
        },
        "limits": {
          "$ref": "#/definitions/v1alpha1ResourceList"
        }
      },
      "description": "Resources follows Kubernetes semantics: requests are what admission\naccounts, limits are what cgroups enforce. The active policy decides\nhow they relate."
    },
    "v1alpha1RuntimeClass": {
      "type": "string",
      "enum": [
        "RUNTIME_CLASS_UNSPECIFIED",
        "RUNTIME_CLASS_CONTAINER",
        "RUNTIME_CLASS_MICROVM"
      ],
      "default": "RUNTIME_CLASS_UNSPECIFIED"
    },
    "v1alpha1Sandbox": {
